#!/usr/bin/env python3
"""Record a screen capture for a project and attach it to its status file.

Usage: record <branch-name> poc|verify [seconds]

Records with screencapture (ctrl-c stops it when no duration is given), saves
to videos/<branch-name>-<kind>[-N].mov, appends the matching evidence bullet to
<branch-name>.md, and bumps last-updated.
"""

import argparse
import re
import subprocess
from datetime import date
from pathlib import Path

BOARD = Path(__file__).resolve().parent
BULLETS = {'poc': 'video-poc', 'verify': 'video'}


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument('branch_name')
    ap.add_argument('kind', choices=sorted(BULLETS))
    ap.add_argument('seconds', nargs='?', type=int,
                    help='record this many seconds instead of until ctrl-c')
    args = ap.parse_args()
    status = BOARD / f'{args.branch_name}.md'
    if not status.is_file():
        raise SystemExit(f'no status file {status}')

    videos = BOARD / 'videos'
    videos.mkdir(exist_ok=True)
    out, n = videos / f'{args.branch_name}-{args.kind}.mov', 2
    while out.exists():
        out, n = videos / f'{args.branch_name}-{args.kind}-{n}.mov', n + 1

    cmd = ['screencapture']
    if args.seconds:
        cmd += ['-V', str(args.seconds)]
        print(f'recording {args.seconds}s to {out} …')
    else:
        cmd.append('-v')
        print(f'recording to {out}, ctrl-c to stop …')
    proc = subprocess.Popen(cmd + [str(out)])
    try:
        proc.wait()
    except KeyboardInterrupt:
        proc.wait()  # ctrl-c reaches screencapture too; it finalizes the file
    if not out.exists() or out.stat().st_size == 0:
        out.unlink(missing_ok=True)
        raise SystemExit('recording failed. Is Screen Recording permission '
                         'granted to this terminal (System Settings → '
                         'Privacy & Security)?')

    bullet = f'- {BULLETS[args.kind]}: ~/{out.relative_to(Path.home())}'
    text = status.read_text().rstrip() + f'\n{bullet}\n'
    text = re.sub(r'(?m)^- last-updated:.*$',
                  f'- last-updated: {date.today().isoformat()}', text)
    status.write_text(text)
    print(f'added `{bullet}` to {status.name}')


if __name__ == '__main__':
    main()
